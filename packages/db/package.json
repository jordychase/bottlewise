{
  "name": "@bottlewise/db",
  "version": "0.0.1",
  "private": true,
  "description": "Bottlewise database layer: migrations, seeds, source adapters",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "seed:list": "tsx --env-file-if-exists=.env src/sources/bin/seed.ts --list",
    "seed:dry": "tsx --env-file-if-exists=.env src/sources/bin/seed.ts --dry",
    "seed:validate": "tsx --env-file-if-exists=.env src/sources/bin/seed.ts --validate",
    "seed": "tsx --env-file-if-exists=.env src/sources/bin/seed.ts",
    "fda": "tsx --env-file-if-exists=.env src/sources/bin/fda.ts",
    "merge": "tsx --env-file-if-exists=.env src/sources/bin/merge.ts",
    "creds:check": "tsx --env-file-if-exists=.env src/sources/bin/creds.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cheerio": "^1.0.0-rc.12"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
