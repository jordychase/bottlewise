{
  "name": "@bottlewise/db",
  "version": "0.0.1",
  "private": true,
  "description": "Bottlewise database layer: migrations, seeds, source adapters",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "seed:list": "tsx src/sources/bin/seed.ts --list",
    "seed:dry": "tsx src/sources/bin/seed.ts --dry",
    "seed": "tsx src/sources/bin/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.0.0-rc.12"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
