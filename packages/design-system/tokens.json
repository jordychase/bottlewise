{
  "$comment": "Bottlewise design tokens. Source of truth: colors_and_type.css. Consume from Expo (StyleSheet) or Tailwind (theme.extend). When colors_and_type.css changes, this file must be updated in lockstep — they are two views of the same data.",
  "$schema": "https://schemas.bottlewise.ai/tokens/v1",
  "version": "1.0.0",

  "color": {
    "raw": {
      "oat":         { "value": "#F6F1E8", "comment": "primary surface" },
      "paper":       { "value": "#FBF7EE", "comment": "raised surface, cards" },
      "mist":        { "value": "#E6DFCF", "comment": "hairlines, dividers" },
      "ink":         { "value": "#1F2A26", "comment": "primary text / UI" },
      "ink2":        { "value": "#5A6862", "comment": "secondary text" },
      "ink3":        { "value": "#94A09B", "comment": "placeholder, disabled" },
      "sage":        { "value": "#6B8E7F", "comment": "primary action" },
      "sageDeep":    { "value": "#4A6B5D", "comment": "hover/pressed primary" },
      "sageSoft":    { "value": "#DCE6DF", "comment": "selected fill, chip bg" },
      "clay":        { "value": "#C77E5C", "comment": "accent / cost emphasis. NOT safety." },
      "claySoft":    { "value": "#F2DECE" },
      "honey":       { "value": "#D4A24C", "comment": "informational (e.g. import badge)" },
      "honeySoft":   { "value": "#F1E2BD" }
    },
    "semantic": {
      "bg":          { "value": "{color.raw.oat}" },
      "bgRaised":    { "value": "{color.raw.paper}" },
      "fg1":         { "value": "{color.raw.ink}" },
      "fg2":         { "value": "{color.raw.ink2}" },
      "fg3":         { "value": "{color.raw.ink3}" },
      "border":      { "value": "{color.raw.mist}" },
      "borderStrong":{ "value": "#C9C0AB" },
      "primary":     { "value": "{color.raw.sage}" },
      "primaryDeep": { "value": "{color.raw.sageDeep}" },
      "primarySoft": { "value": "{color.raw.sageSoft}" },
      "onPrimary":   { "value": "{color.raw.paper}" },
      "accent":      { "value": "{color.raw.clay}" }
    },
    "state": {
      "success":     { "value": "#5C8A6E", "soft": "#DCE6DF", "comment": "in-stock / positive trial outcome" },
      "warning":     { "value": "#C77E5C", "soft": "#F2DECE", "comment": "low-stock / cost-impact" },
      "info":        { "value": "#5C7A8A", "soft": "#D6DEE3", "comment": "European import / general info" }
    },
    "safety": {
      "$comment": "RESERVED EXCLUSIVELY FOR: active recalls, allergic reactions, pediatrician interstitial. Never used for marketing, generic CTAs, validation errors, or low-stock signals.",
      "danger":      { "value": "#A94B3B", "comment": "terracotta-red — never pure red" },
      "dangerDeep":  { "value": "#8C3829", "comment": "pressed state on danger surfaces" },
      "dangerSoft":  { "value": "#ECCFC8", "comment": "soft fill on safety banners" },
      "onDanger":    { "value": "#FFFFFF" }
    },
    "scrim":         { "value": "rgba(31, 42, 38, 0.32)" },
    "barBlurBg":     { "value": "rgba(246, 241, 232, 0.72)" }
  },

  "wcag": {
    "$comment": "AA pairings. 'aa' = 4.5:1 for text under 18px or 14px bold. 'aaLarge' = 3:1 for ≥18px or ≥14px bold. 'fail' = do not use.",
    "pairs": [
      { "fg": "ink",      "bg": "oat",        "ratio": 13.4, "level": "aa"      },
      { "fg": "ink",      "bg": "paper",      "ratio": 14.1, "level": "aa"      },
      { "fg": "ink",      "bg": "sageSoft",   "ratio": 11.2, "level": "aa"      },
      { "fg": "ink2",     "bg": "oat",        "ratio": 6.1,  "level": "aa"      },
      { "fg": "ink2",     "bg": "paper",      "ratio": 6.4,  "level": "aa"      },
      { "fg": "ink3",     "bg": "oat",        "ratio": 3.1,  "level": "aaLarge" },
      { "fg": "paper",    "bg": "sage",       "ratio": 3.6,  "level": "aaLarge", "comment": "OK for ≥18px or button labels at 16px+" },
      { "fg": "paper",    "bg": "sageDeep",   "ratio": 5.7,  "level": "aa"      },
      { "fg": "ink",      "bg": "claySoft",   "ratio": 11.0, "level": "aa"      },
      { "fg": "white",    "bg": "danger",     "ratio": 5.4,  "level": "aa"      },
      { "fg": "white",    "bg": "dangerDeep", "ratio": 7.8,  "level": "aa"      },
      { "fg": "danger",   "bg": "oat",        "ratio": 4.9,  "level": "aa"      },
      { "fg": "danger",   "bg": "dangerSoft", "ratio": 4.2,  "level": "aaLarge" }
    ]
  },

  "type": {
    "family": {
      "display": { "value": "'Newsreader', ui-serif, Georgia, serif" },
      "body":    { "value": "'Hanken Grotesk', system-ui, -apple-system, 'Segoe UI', sans-serif" },
      "mono":    { "value": "'JetBrains Mono', ui-monospace, Menlo, monospace" }
    },
    "scale": {
      "$comment": "1.2 modular scale rooted at 16px. px values; convert to rem at consumer.",
      "12": 12, "13": 13, "14": 14, "15": 15, "16": 16,
      "18": 18, "20": 20, "24": 24, "28": 28, "32": 32, "40": 40, "48": 48, "64": 64
    },
    "lineHeight": { "tight": 1.05, "snug": 1.2, "normal": 1.5, "loose": 1.65 },
    "letterSpacing": { "tight": "-0.02em", "snug": "-0.01em", "normal": 0, "wide": "0.04em", "caps": "0.08em" },
    "weight": { "regular": 400, "medium": 500, "semi": 600, "bold": 700 },
    "role": {
      "display1":  { "family": "display", "size": 64, "lh": "tight",  "weight": "semi",    "tracking": "tight" },
      "display2":  { "family": "display", "size": 48, "lh": "tight",  "weight": "semi",    "tracking": "tight" },
      "h1":        { "family": "display", "size": 32, "lh": "snug",   "weight": "semi",    "tracking": "tight" },
      "h2":        { "family": "display", "size": 24, "lh": "snug",   "weight": "semi",    "tracking": "snug"  },
      "h3":        { "family": "body",    "size": 18, "lh": "snug",   "weight": "semi",    "tracking": "snug"  },
      "h4":        { "family": "body",    "size": 15, "lh": "snug",   "weight": "semi",    "tracking": "normal"},
      "lead":      { "family": "body",    "size": 18, "lh": "normal", "weight": "regular", "tracking": "normal"},
      "body":      { "family": "body",    "size": 16, "lh": "normal", "weight": "regular", "tracking": "normal"},
      "small":     { "family": "body",    "size": 14, "lh": "normal", "weight": "regular", "tracking": "normal"},
      "caption":   { "family": "body",    "size": 13, "lh": "normal", "weight": "regular", "tracking": "normal"},
      "micro":     { "family": "body",    "size": 12, "lh": "normal", "weight": "regular", "tracking": "normal"},
      "eyebrow":   { "family": "body",    "size": 12, "lh": "normal", "weight": "semi",    "tracking": "caps", "transform": "uppercase" },
      "numeric":   { "family": "display", "features": ["tnum", "lnum"] }
    }
  },

  "spacing": {
    "$comment": "4px base scale.",
    "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24,
    "8": 32, "10": 40, "14": 56, "18": 72, "24": 96
  },

  "radius": {
    "1": 2, "2": 8, "3": 12, "4": 16, "5": 24, "pill": 9999
  },

  "elevation": {
    "$comment": "Low-elevation system. e1 is a hairline, not a blur.",
    "e1": { "shadow": "0 1px 0 #E6DFCF" },
    "e2": { "shadow": "0 8px 24px -12px rgba(31, 42, 38, 0.18)" },
    "e3": { "shadow": "0 24px 48px -16px rgba(31, 42, 38, 0.24)" }
  },

  "motion": {
    "easing": {
      "calm":     "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "$comment": "Calm-out only. No bounce, no overshoot. The brand has one easing curve."
    },
    "duration": {
      "1": 120,
      "2": 200,
      "3": 320,
      "$comment": "ms. Nothing over 400. Reduced-motion collapses distance + stagger to 0; fades remain."
    },
    "stagger": {
      "recommendation": 80,
      "$comment": "ms between cascaded recommendation cards. The only 'designed' moment in the system."
    }
  },

  "layout": {
    "breakpoint": { "mobile": 0, "tablet": 720, "desktop": 1024, "wide": 1440 },
    "column": { "mobileMin": 360, "mobileMax": 480, "gutter": 20 },
    "anchorScreens": { "mobile": [390, 844], "desktop": [1440, 900] }
  },

  "tailwind": {
    "$comment": "Drop-in shape for tailwind.config.js → theme.extend. Consumers may also generate this via style-dictionary.",
    "colors": {
      "oat": "#F6F1E8", "paper": "#FBF7EE", "mist": "#E6DFCF",
      "ink": { "DEFAULT": "#1F2A26", "2": "#5A6862", "3": "#94A09B" },
      "sage": { "DEFAULT": "#6B8E7F", "deep": "#4A6B5D", "soft": "#DCE6DF" },
      "clay": { "DEFAULT": "#C77E5C", "soft": "#F2DECE" },
      "honey": { "DEFAULT": "#D4A24C", "soft": "#F1E2BD" },
      "danger": { "DEFAULT": "#A94B3B", "deep": "#8C3829", "soft": "#ECCFC8" },
      "info": { "DEFAULT": "#5C7A8A", "soft": "#D6DEE3" }
    },
    "fontFamily": {
      "display": ["Newsreader", "ui-serif", "Georgia", "serif"],
      "body": ["Hanken Grotesk", "system-ui", "-apple-system", "sans-serif"],
      "mono": ["JetBrains Mono", "ui-monospace", "Menlo", "monospace"]
    },
    "borderRadius": { "1": "2px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "pill": "9999px" }
  }
}
